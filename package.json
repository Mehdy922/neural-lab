    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.30.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
